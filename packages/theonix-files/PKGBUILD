# Maintainer: The Theonix Project <team@theonix.org>
pkgname=theonix-files
pkgver=1.0.0
pkgrel=1
pkgdesc="Native Modern File Manager for Theonix OS"
arch=('any')
url="https://github.com/kelvinkbk/TheonixOS"
license=('GPL3')
depends=('python' 'python-pyqt6')
source=("local-source::git+file://${PWD%/*/*}/.git")
md5sums=('SKIP')

prepare() {
    if [ -d "$srcdir/../../../theonix-files" ]; then
        cp -r "$srcdir/../../../theonix-files" "$srcdir/"
    elif [ -d "$srcdir/local-source/theonix-files" ]; then
        cp -r "$srcdir/local-source/theonix-files" "$srcdir/"
    fi
}

package() {
    install -Dm755 "$srcdir/theonix-files/main.py" "$pkgdir/usr/local/bin/theonix-files"
    install -Dm644 "$srcdir/theonix-files/org.theonix.Files.desktop" "$pkgdir/usr/share/applications/org.theonix.Files.desktop"
}
