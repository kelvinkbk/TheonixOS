# Maintainer: The Theonix Project <team@theonix.org>
pkgname=theonix-browser
pkgver=1.0.0
pkgrel=1
pkgdesc="Native Modern Web Browser with THAID AI Sidebar for Theonix OS"
arch=('any')
url="https://github.com/kelvinkbk/TheonixOS"
license=('GPL3')
depends=('python' 'python-pyqt6' 'qt6-webengine')
source=("local-source::git+file://${PWD%/*/*}/.git")
md5sums=('SKIP')

prepare() {
    if [ -d "$srcdir/../../../theonix-browser" ]; then
        cp -r "$srcdir/../../../theonix-browser" "$srcdir/"
    elif [ -d "$srcdir/local-source/theonix-browser" ]; then
        cp -r "$srcdir/local-source/theonix-browser" "$srcdir/"
    fi
}

package() {
    install -Dm755 "$srcdir/theonix-browser/main.py" "$pkgdir/usr/local/bin/theonix-browser"
    install -Dm644 "$srcdir/theonix-browser/org.theonix.Browser.desktop" "$pkgdir/usr/share/applications/org.theonix.Browser.desktop"
}
