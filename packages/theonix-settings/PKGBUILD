# Maintainer: The Theonix Project <team@theonix.org>
pkgname=theonix-settings
pkgver=1.0.0
pkgrel=1
pkgdesc="Native System Settings & Control Center for Theonix OS"
arch=('any')
url="https://github.com/kelvinkbk/TheonixOS"
license=('GPL3')
depends=('python' 'python-pyqt6' 'networkmanager' 'pipewire')
source=("local-source::git+file://${PWD%/*/*}/.git")
md5sums=('SKIP')

prepare() {
    if [ -d "$srcdir/../../../theonix-settings" ]; then
        cp -r "$srcdir/../../../theonix-settings" "$srcdir/"
    elif [ -d "$srcdir/local-source/theonix-settings" ]; then
        cp -r "$srcdir/local-source/theonix-settings" "$srcdir/"
    fi
}

package() {
    install -Dm755 "$srcdir/theonix-settings/main.py" "$pkgdir/usr/local/bin/theonix-settings"
    install -Dm644 "$srcdir/theonix-settings/org.theonix.Settings.desktop" "$pkgdir/usr/share/applications/org.theonix.Settings.desktop"
}
