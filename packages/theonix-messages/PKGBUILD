# Maintainer: The Theonix Project <team@theonix.org>
pkgname=theonix-messages
pkgver=1.0.0
pkgrel=1
pkgdesc="Native AI Chat & Messaging Hub for Theonix OS"
arch=('any')
url="https://github.com/kelvinkbk/TheonixOS"
license=('GPL3')
depends=('python' 'python-pyqt6')
source=("local-source::git+file://${PWD%/*/*}/.git")
md5sums=('SKIP')

prepare() {
    if [ -d "$srcdir/../../../theonix-messages" ]; then
        cp -r "$srcdir/../../../theonix-messages" "$srcdir/"
    elif [ -d "$srcdir/local-source/theonix-messages" ]; then
        cp -r "$srcdir/local-source/theonix-messages" "$srcdir/"
    fi
}

package() {
    install -Dm755 "$srcdir/theonix-messages/main.py" "$pkgdir/usr/local/bin/theonix-messages"
    install -Dm644 "$srcdir/theonix-messages/org.theonix.Messages.desktop" "$pkgdir/usr/share/applications/org.theonix.Messages.desktop"
}
