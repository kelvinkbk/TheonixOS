# Plymouth Boot Theme for Theonix OS
# Pure bitmap rendering — zero unicode glyph artifacts

# ── Screen dimensions ──────────────────────────────────────────
screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

# ── Background ─────────────────────────────────────────────────
bg_img    = Image("background.png");
bg_sprite = Sprite(bg_img);
bg_sprite.SetX(0);
bg_sprite.SetY(0);
bg_sprite.SetZ(-100);

# ── Theonix Logo ───────────────────────────────────────────────
logo_img = Image("logo.png");
if (logo_img) {
    logo_w = logo_img.GetWidth();
    logo_h = logo_img.GetHeight();
    # Scale down if logo is large
    if (logo_w > 120) {
        scale_factor = 120 / logo_w;
        logo_img = logo_img.Scale(120, logo_h * scale_factor);
        logo_w = 120;
        logo_h = logo_h * scale_factor;
    }
    logo_sprite = Sprite(logo_img);
    logo_x = (screen_width - logo_w) / 2;
    logo_y = (screen_height / 2) - 80;
    logo_sprite.SetX(logo_x);
    logo_sprite.SetY(logo_y);
    logo_sprite.SetZ(10);
} else {
    logo_h = 0;
    logo_y = (screen_height / 2) - 40;
}

# ── "THEONIX OS" Title Text ────────────────────────────────────
label_img = Image.Text("THEONIX OS", 0.0, 1.0, 0.67, 1.0);
label_sprite = Sprite(label_img);
label_sprite.SetX((screen_width - label_img.GetWidth()) / 2);
label_sprite.SetY(logo_y + logo_h + 18);
label_sprite.SetZ(11);

# ── Smooth Glowing Progress Line Bar ───────────────────────────
bar_w = 320;
bar_h = 4;
bar_x = (screen_width - bar_w) / 2;
bar_y = logo_y + logo_h + 56;

# Background Bar
bar_bg_img = Image("progress_bar_bg.png");
if (bar_bg_img) {
    bar_bg_sprite = Sprite(bar_bg_img);
    bar_bg_sprite.SetX(bar_x);
    bar_bg_sprite.SetY(bar_y);
    bar_bg_sprite.SetZ(15);
}

# Filled Progress Bar (Cropped dynamically)
bar_fill_full_img = Image("progress_bar_fill.png");
bar_fill_sprite = Sprite();
bar_fill_sprite.SetX(bar_x);
bar_fill_sprite.SetY(bar_y);
bar_fill_sprite.SetZ(16);

# ── Animation Callback ─────────────────────────────────────────
glow_op = 0.8;
glow_dir = 0.01;

fun refresh_callback() {
    glow_op = glow_op + glow_dir;
    if (glow_op >= 1.0) { glow_op = 1.0; glow_dir = -0.015; }
    if (glow_op <= 0.6) { glow_op = 0.6; glow_dir = 0.015; }
    if (logo_sprite) {
        logo_sprite.SetOpacity(glow_op);
    }
}

fun boot_progress_callback(duration, progress) {
    if (bar_fill_full_img) {
        current_w = Math.Int(bar_w * progress);
        if (current_w < 1) { current_w = 1; }
        if (current_w > bar_w) { current_w = bar_w; }
        
        cropped_img = bar_fill_full_img.Crop(0, 0, current_w, bar_h);
        bar_fill_sprite.SetImage(cropped_img);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(boot_progress_callback);
